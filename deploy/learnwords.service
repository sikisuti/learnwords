# systemd unit for the Raspberry Pi.
#   sudo cp deploy/learnwords.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now learnwords
[Unit]
Description=Learn Words
After=network.target

[Service]
Type=simple
User=learnwords
Group=learnwords
WorkingDirectory=/opt/learnwords
# /var/lib/learnwords is created and owned by the service user (StateDirectory).
StateDirectory=learnwords
Environment=NODE_ENV=production
Environment=DATA_DIR=/var/lib/learnwords
Environment=PORT=3000
# Set to true when the app is served over HTTPS (e.g. behind a reverse proxy).
Environment=COOKIE_SECURE=false
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning --max-old-space-size=200 dist/src/main.js
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
